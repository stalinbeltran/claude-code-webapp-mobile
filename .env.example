# Configuracion de claude-code-webapp-mobile. Copia a .env y rellena.
#
# ⚠ El .env NO se commitea (esta en .gitignore, y este repo es PUBLICO).
# Este fichero de ejemplo si: es lo que permite saber que variables se piden
# sin tener que leer el codigo.
#
# En una maquina de la flota NO se rellena a mano: el lanzador escribe este
# .env solo, quitando el prefijo CWEB_ a las variables del llavero
# (services/claude-web.json declara env_prefix "CWEB_"). O sea que
# CWEB_TS_AUTHKEY en el mini llega aqui como TS_AUTHKEY.




# --- El secreto de Tailscale ---------------------------------------------



# --- Configuracion, sin secretos ----------------------------------------

# Puerto del servidor de lectura. Escucha SOLO en 127.0.0.1 a proposito:
# quien alcance este puerto llega a una maquina donde claude corre con
# bypassPermissions, y la allowlist del bot no lo cubre. Desde fuera se
# entra por `tailscale serve`, que hace de proxy contra este mismo loopback.
CWEB_PORT=8020

# A que direcciones se ata el servidor (coma-separado). Vacio = loopback MAS la
# IP de esta maquina en la tailnet, que es lo que hace que la web se vea desde
# el movil POR IP, sin depender de que resuelva MagicDNS.
#
# Desde el 2026-09-12: `tailscale serve` enruta por la cabecera Host, asi que la
# app se veia por su nombre y POR IP DABA 404. Si el movil no resolvia el nombre,
# no habia ninguna direccion que funcionara. Una IP no depende del DNS de nadie.
#
# ⚠ Solo se aceptan loopback y la tailnet (CGNAT 100.64.0.0/10). Un comodin
# (0.0.0.0, ::) ataria tambien la IP PUBLICA del droplet, y por ese puerto se
# llega al mismo sitio que un mensaje de Telegram -- una maquina donde claude
# corre con bypassPermissions -- sin la allowlist del bot. Se rechaza y se dice.
# Loopback se ata SIEMPRE aunque no se ponga: de ahi cuelgan la sonda de
# `cweb estado` y el tunel SSH de emergencia.
CWEB_BIND=

# El TOKEN de la puerta. Si esta vacio, `cweb instalar` genera uno y lo guarda en
# ~/.config/cweb.env (modo 600). Ponerlo AQUI -o mejor, en el llavero del
# lanzador como CWEB_TOKEN- es lo unico que hace que el token SOBREVIVA a rehacer
# la maquina: si no, cada dev nuevo tiene uno distinto y hay que pedirlo otra vez.
#
# ⚠⚠ SIN TOKEN LA WEB SOLO ESCUCHA EN LOOPBACK, a proposito: por este puerto se
# llega al mismo sitio que un mensaje de Telegram -una maquina donde claude corre
# con bypassPermissions- y SIN la allowlist del bot. La exposicion y la puerta son
# la misma decision.
#
# ⚠ El token viaja EN CLARO (no hay TLS), igual que el de foveal-vision-web. Y la
# URL que da `cweb url` LLEVA LA LLAVE dentro: quien la tenga, entra.
CWEB_TOKEN=




# Cada cuanto se releen los ficheros de conversacion, en milisegundos.
CWEB_SONDEO_MS=


# Donde estan los ficheros de conversacion que esta web LEE. Si se deja
# vacio, cae al data/ del coordinador de esta maquina -- el sitio de
# siempre -- y lo anuncia al arrancar.
CWEB_DATA_DIR=

# Raiz del repo del coordinador, si no es ~/src/telegram-coordinator.
COORD_HOME=

# ─────────────────────────────────────────────────────────────────────────────
# ⚠⚠ CERO TAILSCALE DESDE EL 2026-09-12 (decision del dueno).
# Se fueron TS_AUTHKEY, TS_CERT_B64, TS_KEY_B64, CWEB_ACCESO, CF_TUNNEL_TOKEN,
# CF_HOSTNAME, CWEB_TS_ESQUEMA, CWEB_PUERTO_TS, CWEB_HOSTNAME y las TS_OAUTH_*,
# y con ellas el nodo, el `serve`, el certificado y el tunel.
#
# Hoy se entra por la IP PUBLICA del droplet con el token en la URL. Lo que hay
# que configurar es CWEB_TOKEN (arriba) y nada mas.
# ─────────────────────────────────────────────────────────────────────────────
